# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Shared HMAC secret for Sanity → /api/webhooks/sanity/protocol.
# Generate with: openssl rand -hex 32. Add to Sanity Studio → Manage →
# API → Webhooks → Secret. See spec/SANITY-WEBHOOK-SETUP.md.
SANITY_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@preciseaesthetics.com
RESEND_INTERNAL_NOTIFY_EMAIL=demos@preciseaesthetics.com

# Cal.com
NEXT_PUBLIC_CAL_LINK=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site
NEXT_PUBLIC_SITE_URL=https://preciseaesthetics.com

# Anthropic (P11 — admin AI agents)
# Server-only — never reaches the client. Used by lib/agents/* via
# /api/admin/ai/*. Get key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
